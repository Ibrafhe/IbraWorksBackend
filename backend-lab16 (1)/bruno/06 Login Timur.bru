meta {
  name: 06 Login Timur
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: Timur
  password: kilc-chat-2026
}

script:post-response {
  bru.setEnvVar("token_timur", res.body.access_token);
}

assert {
  res.status: eq 200
  res.body.token_type: eq bearer
}
