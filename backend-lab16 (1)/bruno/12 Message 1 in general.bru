meta {
  name: 12 Message 1 in general
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/rooms/1/messages
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {"text": "hello everyone"}
}

assert {
  res.status: eq 201
  res.body.id: eq 1
  res.body.room_id: eq 1
  res.body.author.name: eq Aida
}
