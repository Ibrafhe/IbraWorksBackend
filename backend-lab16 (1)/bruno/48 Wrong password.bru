meta {
  name: 48 Wrong password
  type: http
  seq: 48
}

post {
  url: {{baseUrl}}/auth/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: Aida
  password: kilc-chat-2025
}

assert {
  res.status: eq 401
  res.body.code: eq bad_credentials
  res.headers["www-authenticate"]: eq Bearer
}
